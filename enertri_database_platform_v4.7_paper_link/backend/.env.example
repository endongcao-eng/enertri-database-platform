# EnerTri V4.2 本地开发配置
DATABASE_URL=sqlite:///./enertri.db
SECRET_KEY=please-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MEDIA_DIR=./media
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000
APP_ENV=development

# ===== AI / 文献服务 =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_SECONDS=180
OPENALEX_API_KEY=
LITERATURE_CONTACT_EMAIL=your-email@example.com
LITERATURE_TIMEOUT_SECONDS=30

# ===== 文件治理 =====
ARTIFACT_DIR=./media/artifacts
WORKSPACE_DIR=./media/workspace
FILE_STORE_DIR=./media/files
FILE_MAX_MB=50
WORKSPACE_MAX_FILE_MB=30
WORKSPACE_MAX_FILES=8
TEMP_FILE_RETENTION_HOURS=24

# ===== V4.2 独立数据库任务 Worker =====
# Web 进程仅创建 queued 任务；请另启：python scripts/task_worker.py
TASK_EXECUTION_MODE=database_worker
TASK_POLL_SECONDS=1
TASK_LEASE_SECONDS=90
TASK_HEARTBEAT_SECONDS=20
TASK_DEFAULT_TIMEOUT_SECONDS=1800
TASK_TIMEOUT_PAPER_INGEST_SECONDS=3600
TASK_STEP_DELAY_SECONDS=0.05

# ===== 论文解析 / OCR =====
OCR_LANG=eng
OCR_MIN_TEXT_CHARS=60

# ===== 旧库基线保护 =====
# 生产环境中，仅当数据库确实是标准 V4.0 且已备份/人工核验时设置：
# V4_BASELINE_CONFIRM=I_HAVE_VERIFIED_V4_0_BACKUP

# ===== 外部 CAE =====
SIMULATION_EXECUTION_ENABLED=false
SIM_HYPERMESH_COMMAND=
SIM_ANSYS_MAPDL_COMMAND=
SIM_ANSYS_FLUENT_COMMAND=
SIM_MARC_COMMAND=
SIM_FLOW3D_COMMAND=
