APP_ENV=production
DATABASE_URL=postgresql+psycopg://enertri_user:REPLACE_WITH_SAME_DB_PASSWORD@db:5432/enertri
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
APP_BOOTSTRAP_ON_STARTUP=false
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=https://trial.example.org
MEDIA_DIR=/app/media
FILE_STORE_DIR=/app/media/files
ARTIFACT_DIR=/app/media/artifacts
WORKSPACE_DIR=/app/media/workspace
TASK_EXECUTION_MODE=database_worker
SIMULATION_EXECUTION_ENABLED=false
OPENAI_API_KEY=
WORKSPACE_MAX_FILE_MB=30
WORKSPACE_MAX_FILES=8
LOGIN_ACCOUNT_LIMIT=5
LOGIN_IP_LIMIT=120
LOGIN_WINDOW_SECONDS=900
TASK_USER_ACTIVE_LIMIT=3
TASK_GLOBAL_ACTIVE_LIMIT=100
TASK_USER_DAILY_LIMIT=20
TASK_GLOBAL_RUNNING_LIMIT=2
TASK_USER_RUNNING_LIMIT=1
AI_BUDGET_ENABLED=false
AI_BUDGET_MODEL=
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_REQUEST_RESERVATION_USD=0.10
AI_USER_DAILY_USD=1
AI_GLOBAL_DAILY_USD=10
AI_USER_DAILY_CALLS=20
AI_GLOBAL_DAILY_CALLS=200
AI_USER_CONCURRENCY=1
AI_GLOBAL_CONCURRENCY=2
AI_MAX_INPUT_BYTES=16000
AI_MAX_OUTPUT_TOKENS=1024
